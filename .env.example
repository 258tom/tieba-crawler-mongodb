# ============================================================
#  配置模板
#  用法：复制成 .env（copy .env.example .env）再填自己的值
#  .env 已在 .gitignore 里，不会被提交到仓库
# ============================================================

# ---------- 贴吧登录凭据（必填）----------
# BDUSS 等同账号凭据，泄露 = 别人能用你的号发帖，别外传
# 获取方法：登录 tieba.baidu.com → F12 → Application → Cookies
#           → https://tieba.baidu.com → 复制名为 BDUSS 的 Value
TIEBA_BDUSS=

# ---------- 爬取配置（可选，也可用命令行参数覆盖）----------
TIEBA_FNAME=弱智
TIEBA_MAX_PAGE=32
TIEBA_WORKER_NUM=8

# ---------- MongoDB 连接（可选，默认就是本地）----------
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=tieba
MONGO_COLLECTION=threads
