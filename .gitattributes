# 统一行尾为 LF，避免 Windows 上提交后 GitHub 显示整个文件被改动
* text=auto eol=lf

# 明确指定文本文件类型，保证跨平台一致
*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows 批处理必须用 CRLF
*.cmd   text eol=crlf
*.bat   text eol=crlf

# PowerShell 脚本用 CRLF
*.ps1   text eol=crlf

# 二进制文件不做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.pdf   binary
